// Cloudflare: worker "app", online at https://app.tieout.workers.dev since the switch-over (step 8c, 26.10.2026).
// Until then this app ran as the worker "app-neu" and "app" served v1; v1 is now frozen at https://app-v1.tieout.workers.dev
// (worker "app-v1", built once from the branch `v1`, builds off).
// Static files only, no script: the build output `out/`. Cloudflare builds on every push (Workers Builds, root directory
// `app`, build command `npm run build`): `main` goes online, every other branch gets its own preview address.
{
  "name": "app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Needed by `wrangler preview` (one preview per branch). Empty: the preview takes the assets from above.
  "previews": {}
}
