# Einheitliche Zeilenenden (LF) für Windows und Mac
* text=auto eol=lf

# Windows-Skripte brauchen CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binärdateien
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
*.xlsx binary
*.docx binary
