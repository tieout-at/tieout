// Cloudflare: Worker „app“, online unter https://app.tieout.workers.dev (Konto-Subdomain tieout, seit 22.10.).
// Die App als statische Dateien plus ein kleines Prüfskript davor (worker/index.ts).
// Cloudflare baut bei jedem Push selbst (Workers Builds, Stammverzeichnis product/app):
// main geht online, jeder andere Branch bekommt eine eigene Vorschau-Adresse.
// Anmeldung über Supabase (src/anmeldung/konfig.ts); solange dort nichts steht, lässt das Skript alles durch
// und der Schutz läuft wie bisher über Cloudflare Access (eingestellt im Dashboard, nicht hier).
// Geheimer Schlüssel nur als Secret: `npx wrangler secret put SUPABASE_SECRET_KEY` oder im Dashboard.
{
  "name": "app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Für das Claude-SDK des WhatsApp-Agenten (product/whatsapp, Route /api/zuruf/…). Schalter: Variable ZURUF_ECHT=an
  // (Standard aus, online erst mit Go Maxi S.), Schlüssel als Secret ANTHROPIC_API_KEY.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Das Skript läuft vor allen Seiten, nicht vor Bausteinen und der Anmeldeseite (spart Aufrufe).
    "run_worker_first": ["/*", "!/_next/static/*", "!/anmelden/*"]
  },
  "workers_dev": true,
  "preview_urls": true,
  // Pflicht für `wrangler preview` (Vorschau je Branch). Leer: die Vorschau nimmt die Assets von oben.
  "previews": {}
}
